# Response headers for Cloudflare Pages, which reads dist/_headers (Vite copies
# this file there). The only source for these headers: vite.config.js reads the
# /* rule for dev and preview, and scripts/check-tooling.py checks it.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Comparison pages of the diagnostics page (#56, public/diagnostics/README.md):
# only the isolation headers differ. `! Name` removes a header set by /*.
/diagnostics/credentialless/*
  ! Cross-Origin-Embedder-Policy
  Cross-Origin-Embedder-Policy: credentialless

/diagnostics/no-isolation/*
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
